        <!-- ===================== Title ===================== -->
        <mxCell id="title" value="&lt;b&gt;研究之道 — 工作流程&lt;/b&gt;" style="text;html=1;fontSize=46;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="52" y="12" width="1816" height="47" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="从苏格拉底对话到结构化研究备忘录" style="text;html=1;fontSize=27;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#64748B;" vertex="1" parent="1">
          <mxGeometry x="52" y="63" width="1816" height="29" as="geometry" />
        </mxCell>

        <!-- ============================================================ -->
        <!-- Phase A — Dialogue Exploration (Indigo)                      -->
        <!-- ============================================================ -->
        <mxCell id="phaseA" value="&lt;b&gt;阶段 A — 对话探索&lt;/b&gt;" style="swimlane;startSize=58;fillColor=#4F46E5;gradientColor=#4338CA;swimlaneFillColor=#F8FAFC;strokeColor=#4F46E5;fontColor=#FFFFFF;fontSize=37;whiteSpace=wrap;html=1;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="52" y="112" width="572" height="780" as="geometry" />
        </mxCell>

        <mxCell id="a1" value="&lt;b&gt;🎯 第一步 — 定义问题&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:27px;color:#64748B;&quot;&gt;你的研究问题是什么？（维度一）&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C7D2FE;shadow=1;fontSize=32;verticalAlign=middle;" vertex="1" parent="phaseA">
          <mxGeometry x="20" y="81.5" width="532" height="100" as="geometry" />
        </mxCell>

        <mxCell id="a2" value="&lt;b&gt;💡 第二步 — 验证意义&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:27px;color:#64748B;&quot;&gt;为什么重要？（维度二）&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C7D2FE;shadow=1;fontSize=32;verticalAlign=middle;" vertex="1" parent="phaseA">
          <mxGeometry x="20" y="196.5" width="532" height="100" as="geometry" />
        </mxCell>

        <mxCell id="a3" value="&lt;b&gt;🏗️ 第三步 — 构建论证&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:27px;color:#64748B;&quot;&gt;逻辑是否严谨完整？（维度三）&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C7D2FE;shadow=1;fontSize=32;verticalAlign=middle;" vertex="1" parent="phaseA">
          <mxGeometry x="20" y="311.5" width="532" height="100" as="geometry" />
        </mxCell>

        <mxCell id="a4" value="&lt;b&gt;⚖️ 第四步 — 检查伦理&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:27px;color:#64748B;&quot;&gt;谁可能受影响？（维度四）&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C7D2FE;shadow=1;fontSize=32;verticalAlign=middle;" vertex="1" parent="phaseA">
          <mxGeometry x="20" y="426.5" width="532" height="100" as="geometry" />
        </mxCell>

        <mxCell id="a5" value="&lt;b&gt;🔭 第五步 — 提出新问题&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:27px;color:#64748B;&quot;&gt;接下来是什么？（维度五）&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C7D2FE;shadow=1;fontSize=32;verticalAlign=middle;" vertex="1" parent="phaseA">
          <mxGeometry x="20" y="541.5" width="532" height="100" as="geometry" />
        </mxCell>

        <mxCell id="a6" value="&lt;b&gt;✍️ 第六步 — 验证可表达&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:27px;color:#64748B;&quot;&gt;写作与展示（维度六 — 可选）&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C7D2FE;shadow=1;fontSize=32;verticalAlign=middle;dashed=1;" vertex="1" parent="phaseA">
          <mxGeometry x="20" y="656.5" width="532" height="100" as="geometry" />
        </mxCell>

        <!-- ============================================================ -->
        <!-- Arrow A → B                                                  -->
        <!-- ============================================================ -->
        <mxCell id="arrowAB" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jumpStyle=none;html=1;strokeWidth=3;strokeColor=#4F46E5;endArrow=blockThin;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
